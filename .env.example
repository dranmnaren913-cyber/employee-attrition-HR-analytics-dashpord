# Local development only. Replace SECRET_KEY with a random private value.
SECRET_KEY=replace-this-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite is the default. Set USE_MYSQL=True and fill the DB_* values to use MySQL.
USE_MYSQL=False
DB_NAME=hr_analytics_db
DB_USER=hr_analytics_user
DB_PASSWORD=replace-with-your-database-password
DB_HOST=127.0.0.1
DB_PORT=3306
